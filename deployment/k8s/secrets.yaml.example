# ==============================================================================
# Kubernetes Secrets Template - Cloud-Native AI Agri Marketplace
# ==============================================================================
# DO NOT commit real secrets to Git.
# Copy this file to secrets.yaml and encode your sensitive values using Base64:
#   [Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes("YourPassword"))
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: agri-secrets
  namespace: agri-marketplace
  labels:
    app.kubernetes.io/name: agri-marketplace
type: Opaque
stringData:
  # Base stringData automatically gets encoded by Kubernetes API server
  DB_PASSWORD: "ChangeThisSecureUserPassword123!"
  DB_ROOT_PASSWORD: "ChangeThisSecureRootPassword123!"
