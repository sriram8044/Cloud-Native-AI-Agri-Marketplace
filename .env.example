# ==============================================================================
# Cloud-Native AI Agri Marketplace - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your secure secrets.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Database Configuration (MySQL 8)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=agri_marketplace
DB_USERNAME=agri_user
DB_PASSWORD=ChangeThisSecureUserPassword123!
DB_ROOT_PASSWORD=ChangeThisSecureRootPassword123!

# Spring Boot Backend Configuration
BACKEND_PORT=8080
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# AI Microservice Configuration
AI_SERVICE_HOST=ai-service
AI_SERVICE_PORT=8000
AI_SERVICE_HOST_PORT=8001
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_CONNECT_TIMEOUT_MS=5000
AI_SERVICE_READ_TIMEOUT_MS=5000

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api
